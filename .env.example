# ==============================================================================
# FreeApply-AI: Configuration Template
# Copy this file to .env and fill in your details:
# cp .env.example .env
# ==============================================================================

# --- SMTP Configuration (Gmail) ---
# NOTE: Do NOT use your standard Google password.
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Search for "App Passwords" and create one labeled "FreeApply-AI"
# 3. Paste the 16-character code below (without spaces):
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Candidate Profile ---
SENDER_NAME=Your Full Name
RESUME_PATH=resume.pdf

# --- Safety & Throttling Limits ---
# Maximum emails to send in a single calendar day (recommended: <= 40)
DAILY_SEND_LIMIT=35

# Delay range in seconds between each email (protects your Gmail inbox reputation)
MIN_DELAY_SECONDS=30
MAX_DELAY_SECONDS=60

# --- Google Gemini AI (Optional - for AI Personalization) ---
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
